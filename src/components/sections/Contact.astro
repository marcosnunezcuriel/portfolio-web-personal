---
import SectionTitle from '../common/SectionTitle.astro';
import ContactCard from '../common/ContactCard.astro';

const currentLanguage = Astro.currentLocale || 'es';
const isEnglish = currentLanguage === 'en';

const contact = {
    title: isEnglish ? "Contact" : "Contacto",
    text: isEnglish ? "Let's work together" : "Trabajemos juntos"
};

---

<section id="contact" class="contact">
    <SectionTitle number = "06" title={contact.title} />

    <h1>{contact.text}</h1>

    <ContactCard />
</section>

<style>

    .contact {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 5rem;
    }

    h1 {
        font-family: var(--font-montserrat);
        font-size: 3.3rem;
        font-style: italic;
        font-weight: 100;
    }

</style>
