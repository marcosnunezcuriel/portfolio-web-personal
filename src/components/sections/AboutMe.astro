---
import SectionTitle from "../common/SectionTitle.astro";

---

<section id="about-me" class="about-me">
    <SectionTitle number = "01", title="Sobre mí"/>

    <div class="content">
        <div class="text">
            <h2 class="full-name">
                <span class="surname">Núñez Curiel</span>
                <span class="firstname">Marcos</span>
            </h2>
            <p class="description">Soy una persona proactiva, organizada y responsable, con buenas relaciones interpersonales. Siempre tengo la mejor disposición para la realización de mi trabajo.</p>
            <a href="#contact" class="contact-button">Contáctame</a>
        </div>
        <div class="image-container">
            <img src="src/assets/mi-foto.png" alt="mi-foto" />
        </div>
    </div>
</section>

<style>

    .about-me {
        margin: 0 10%;
        padding: 1rem 0;
    }

    .content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .full-name {
        display: flex;
        flex-direction: column;
        margin-bottom: 1.5rem;
        font-family: var(--font-montserrat);
        text-transform: uppercase;
    }

    .surname {
        font-size: 3.8rem;
        font-style: italic;
    }

    .firstname {
        font-size: 4.8rem;
    }

    .description {
        max-width: 460px;
        margin-bottom: 2.5rem;
        font-family: var(--font-inter);
        font-size: 1rem;
    }

    .contact-button {
        display: block;
        text-decoration: none;
        background-color: var(--color-blue);
        color: var(--normal-bg);
        border: 1px solid transparent;
        border-radius: 50px;
        padding: 0.75rem 1rem;
        font-family: var(--font-inter);
        font-size: 0.9rem;
        font-weight: 700;
        transition: transform 0.25s ease-in-out;
    }

    .contact-button:hover {
        background-color: var(--normal-bg);
        color: var(--color-blue);
        border: 1px solid var(--color-blue);
        box-shadow: 0 0 15px var(--white-text);
    }

    .image-container {
        width: 320px;
        height: 380px;
        border-radius: 50%;
        overflow: hidden;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

</style>
