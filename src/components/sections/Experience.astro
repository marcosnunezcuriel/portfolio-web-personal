---
import SectionTitle from "../common/SectionTitle.astro";

import JobCard from "../cards/JobCard.astro";

import jobsData from '../../data/jobs.json';
---

<section id="experience" class="experience">
    <SectionTitle number = "02" title="Experiencia"/>

    <div class="jobs">
        {jobsData.map((job) => (
            <JobCard
                role={job.role}
                company={job.company}
                date={job.date}
                description={job.description}
                color={job.color}
            />
        ))}
    </div>
</section>

<style>

    .experience {
        margin: 0 10%;
        padding: 1rem 0;
    }

    .jobs {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

</style>