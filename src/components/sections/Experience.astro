---
import SectionTitle from "../common/SectionTitle.astro";

import JobCard from "../cards/JobCard.astro";

const currentLanguage = Astro.currentLocale || 'es';
const isEnglish = currentLanguage === 'en';

const jobsModule = currentLanguage === 'en' ? await import('../../data/en/jobs.json') : await import('../../data/es/jobs.json');
const jobsData = jobsModule.default;
---

<section id="experience" class="experience">
    <SectionTitle number = "02" title={isEnglish ? "Experience" : "Experiencia"} />

    <div class="jobs">
        {jobsData.map((job) => (
            <JobCard
                role={job.role}
                company={job.company}
                date={job.date}
                description={job.description}
                color={job.color}
            />
        ))}
    </div>
</section>

<style>

    .jobs {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

</style>
