---
import SectionTitle from "../common/SectionTitle.astro";
import Separator from "../common/Separator.astro";

import StudyCard from "../cards/StudyCard.astro";
import LanguageCard from "../cards/LanguageCard.astro";
import SkillCard from "../cards/SkillCard.astro";

const currentLanguage = Astro.currentLocale || 'es';
const isEnglish = currentLanguage === 'en';

const studiesModule = currentLanguage === 'en' ? await import('../../data/en/studies.json') : await import('../../data/es/studies.json');
const studiesData = studiesModule.default;

const languagesModule = currentLanguage === 'en' ? await import('../../data/en/languages.json') : await import('../../data/es/languages.json');
const languagesData = languagesModule.default;

const skillsModule = currentLanguage === 'en' ? await import('../../data/en/skills.json') : await import('../../data/es/skills.json');
const skillsData = skillsModule.default;
---

<section id="education" class="education">
    <SectionTitle number = "05" title={isEnglish ? "Education" : "Educación"} />

    <div class="studies">
        {studiesData.map((study) => (
            <StudyCard
                title={study.title}
                date={study.date}
                institution={study.institution}
                location={study.location}
                color={study.color}
            />
        ))}
    </div>

    <Separator variant='short' />

    <div class="languages">
        {languagesData.map((language) => (
            <LanguageCard
                language={language.language}
                level={language.level}
                flag={language.flag}
                color={language.color}
            />
        ))}
    </div>

    <Separator variant='short' />

    <div class="skills">
        {skillsData.map((skillsGroup) => (
            <h4 class="skill-category">{skillsGroup.emoji} {skillsGroup.category}</h4>
            <div class="skills-group">
                {skillsGroup.skills.map((skill) => (
                    <SkillCard
                        name={skill.name}
                        icon={skill.icon}
                        color={skill.color}
                    />
                ))}
            </div>
        ))}
    </div>

</section>

<style>
    
    .studies {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .languages {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .skills {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .skill-category {
        font-family: var(--font-montserrat);
    }

    .skills-group {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2rem;
    }

</style>
