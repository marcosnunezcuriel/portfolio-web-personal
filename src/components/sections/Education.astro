---
import SectionTitle from "../common/SectionTitle.astro";
import Separator from "../common/Separator.astro";

import StudyCard from "../cards/StudyCard.astro";
import LanguageCard from "../cards/LanguageCard.astro";

import studiesData from '../../data/studies.json';
import languagesData from '../../data/languages.json';
---

<section id="education" class="education">
    <SectionTitle number = "05" title="Educación"/>

    <div class="studies">
        {studiesData.map((study) => (
            <StudyCard
                title={study.title}
                date={study.date}
                institution={study.institution}
                location={study.location}
                color={study.color}
            />
        ))}
    </div>

    <Separator variant='short' />

    <div class="languages">
        {languagesData.map((language) => (
            <LanguageCard
                language={language.language}
                level={language.level}
                flag={language.flag}
                color={language.color}
            />
        ))}
    </div>

</section>

<style>
    
    .studies {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .languages {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

</style>
