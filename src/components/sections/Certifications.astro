---
import SectionTitle from "../common/SectionTitle.astro";

import CertificationCard from "../cards/CertificationCard.astro";

const currentLanguage = Astro.currentLocale || 'es';
const isEnglish = currentLanguage === 'en';

const certificationsModule = currentLanguage === 'en' ? await import('../../data/en/certifications.json') : await import('../../data/es/certifications.json');
const certificationsData = certificationsModule.default;
---

<section id="certifications" class="certifications">
    <SectionTitle number = "03" title={isEnglish ? "Certifications" : "Certificaciones"} />

    <div class="content">
        {certificationsData.map((certification) => (
            <CertificationCard
                title={certification.title}
                platform={certification.platform}
                year={certification.year}
                certificateURL={certification.certificateUrl}
                color={certification.color}
            />
        ))}
    </div>
</section>

<style>

    .content {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(4, 1fr);
    }

</style>
