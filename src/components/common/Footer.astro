---
const currentYear = new Date().getFullYear();

const currentLanguage = Astro.currentLocale || 'es';
const isEnglish = currentLanguage === 'en';

const footer = {
    role: isEnglish ? "Web Developer" : "Desarrollador web",
    location: isEnglish ? "Seville, Andalusia, Spain" : "Sevilla, Andalucía, España",
    projectName: isEnglish ? "My Portfolio" : "Mi portfolio"
};

---

<footer class="footer">
    <img src="src/assets/logo-mnc.png" alt="logo-mnc" class="logo" />
    <span>© {currentYear} • Marcos Núñez Curiel • {footer.role} • {footer.location}</span>
    <span>{footer.projectName}</span>
</footer>

<style>

    .footer {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
        padding: 1.5rem 10%;
        background-color: var(--dark-bg);
    }

    .logo {
        height: 40px;
        display: block;
    }

    .footer span {
        font-family: var(--font-inter);
        color: var(--grey-text);
        font-size: 1rem;
        font-weight: 200;
    }

</style>
