---
import Layout from "../layouts/Layout.astro"

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const notFound = {
    imageURL: isEnglish ? "../src/assets/mi-foto.png" : "/src/assets/mi-foto.png",
    heading: isEnglish ? "Oops! You got lost in the code." : "¡Vaya! Te has perdido en el código.",
    description: isEnglish ? "It looks like the page you are looking for went out for coffee or never existed. Don't worry, you can head back home to keep exploring my portfolio!" : "Parece que la página que buscas se fue a tomar un café o nunca existió. ¡Pero no te preocupes, puedes volver al inicio para seguir explorando mi portfolio!",
    buttonText: isEnglish ? "Back to Home" : "Volver al inicio",
    homeUrl: isEnglish ? "/en" : "/"
}
---

<Layout>
    <main class="not-found">
        <div class="image-container">
            <img src={notFound.imageURL} alt="mi-foto" class="profile-image">
        </div>
        <div class="content">
            <h1 class="error-code">404</h1>
            <h2 class="heading">{notFound.heading}</h2>
            <p class="description">{notFound.description}</p>
            <a href={notFound.homeUrl} class="home-button">{notFound.buttonText}</a>
        </div>
    </main>
</Layout>

<style>

    .not-found {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 50px;
    }

    .image-container {
        width: 280px;
        height: 340px;
        border-radius: 50%;
        overflow: hidden;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .content {
        text-align: center;
    }

    .error-code {
        color: var(--error);
        font-family: var(--font-press-start);
        font-size: 5rem;
        font-weight: 800;
    }

    .heading {
        font-family: var(--font-inter);
        font-size: 1.5rem;
        font-weight: 700;
    }

    .description {
        max-width: 400px;
        color: var(--grey-text);
        font-family: var(--font-inter);
        font-weight: 400;
    }

    .home-button {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--normal-bg);
        border: 1px solid transparent;
        border-radius: 50px;
        padding: 0.75rem ;
        font-family: var(--font-inter);
        font-size: 0.9rem;
        font-weight: 700;
        transition: all 0.25s ease-in-out;
        background-color: var(--error);
    }

    .home-button:hover {
        background-color: var(--normal-bg);
        color: var(--error) !important;
        border: 1px solid var(--error) !important;
        box-shadow: 0 0 15px var(--white-text);
    }

</style>
